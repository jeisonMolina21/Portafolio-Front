    // Position glider
    function updateGlider(btn) {
      const glider = document.getElementById('role-glider');
      if (!btn || !glider) return;
      glider.style.left = `${btn.offsetLeft}px`;
      glider.style.width = `${btn.offsetWidth}px`;
    }

    // Role switcher
    function switchProfile(roleKey, targetBtn) {
      currentRole = roleKey;
      const data = profiles[roleKey];
      if (!data) return;

      document.documentElement.style.setProperty('--role-color', data.color);
      document.documentElement.style.setProperty('--role-glow', data.glow);

      document.getElementById('hero-role-title').innerText = data.title;
      document.getElementById('hero-role-desc').innerText = data.desc;
      document.getElementById('header-cv-label').innerText = `CV (${data.cvTag})`;

      const btn = targetBtn || document.getElementById(`btn-${roleKey}`);
      document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
      if (btn) {
        btn.classList.add('active');
        updateGlider(btn);
      }

      // Map role to corresponding AI agent
      if (roleKey === 'fullstack') switchAgent('acad');
      else if (roleKey === 'automation') switchAgent('job');
      else if (roleKey === 'helpdesk') switchAgent('home');
    }

    // Switch active agent
    function switchAgent(agentKey) {
      currentAgent = agentKey;
      const data = agentsData[agentKey];
      if (!data) return;

      // Update tabs
      ['tg', 'job', 'acad', 'home'].forEach(k => {
        const btn = document.getElementById(`tab-${k}`);
        if (btn) btn.classList.toggle('active', k === agentKey);
      });

      // Update Header info
      const typeTag = document.getElementById('agent-type-tag');
      if (typeTag) typeTag.innerText = data.tag;
      const titleText = document.getElementById('agent-title-text');
      if (titleText) titleText.innerText = data.title;
      const missionText = document.getElementById('agent-mission-text');
      if (missionText) missionText.innerText = data.mission;
      const filename = document.getElementById('payload-filename');
      if (filename) filename.innerText = data.file;
      const statusBadge = document.getElementById('payload-status-badge');
      if (statusBadge) statusBadge.innerHTML = data.status;

      // Stats pills
      const statsContainer = document.getElementById('agent-stats-container');
      if (statsContainer) {
        statsContainer.innerHTML = data.stats.map(s => `
          <div class="agent-stat-pill">
            <span>${s.label}</span>
            <span>${s.val}</span>
          </div>
        `).join('');
      }

      // Badges
      const badgesContainer = document.getElementById('agent-badges-container');
      if (badgesContainer) {
        badgesContainer.innerHTML = data.chips.map(c => `
          <span class="tech-pill">${c}</span>
        `).join('');
      }

      // Render Pipeline Nodes
      const nodesContainer = document.getElementById('pipeline-nodes-container');
      if (nodesContainer) {
        nodesContainer.innerHTML = data.nodes.map((n, i) => `
          <div class="pipeline-step-card" id="step-node-${i}">
            <span class="step-badge ${n.badgeClass}">${n.badge}</span>
            <div class="step-title">${n.title}</div>
            <div class="step-sub">${n.sub}</div>
          </div>
          ${i < data.nodes.length - 1 ? `
            <div class="pipeline-arrow" id="step-arrow-${i}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
          ` : ''}
        `).join('');
      }

      // Payload JSON
      const codeDisplay = document.getElementById('payload-code-display');
      if (codeDisplay) codeDisplay.innerHTML = data.payload;
    }

    // Simulate animated pipeline execution
    function simulatePipeline() {
      const data = agentsData[currentAgent];
      if (!data) return;

      // Pulse animation across nodes in sequence
      data.nodes.forEach((_, i) => {
        setTimeout(() => {
          const card = document.getElementById(`step-node-${i}`);
          const arrow = document.getElementById(`step-arrow-${i}`);
          if (card) {
            card.classList.add('pulse-highlight');
            setTimeout(() => card.classList.remove('pulse-highlight'), 550);
          }
          if (arrow) {
            arrow.classList.add('active');
            setTimeout(() => arrow.classList.remove('active'), 550);
          }
        }, i * 240);
      });

      setTimeout(() => {
        showToast(`Flujo "${data.title}" completado con éxito (200 OK)`);
      }, data.nodes.length * 240);
    }

