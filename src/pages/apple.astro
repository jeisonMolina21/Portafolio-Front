    .syn-kw { color: #f43f5e; font-weight: 600; }
    .syn-fn { color: #a855f7; font-weight: 600; }
    .syn-st { color: #38bdf8; }
    .syn-ok { color: #34d399; font-weight: 700; }

    /* ── Tech Ecosystem Ribbon ── */
    .tech-ribbon {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 1rem 0;
      justify-content: center;
      flex-wrap: wrap;
    }
    .tech-ribbon::-webkit-scrollbar { display: none; }
    .tech-ribbon-item {
      display: inline-flex;
      align-items: center;
