    // Theme Management (Light / Dark Mode with Apple Standards & Persistence)
    function setTheme(theme) {
      const sun = document.getElementById('theme-sun-icon');
      const moon = document.getElementById('theme-moon-icon');
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
        if (sun) sun.style.display = 'block';
        if (moon) moon.style.display = 'none';
        localStorage.setItem('jm_portfolio_theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
        if (sun) sun.style.display = 'none';
        if (moon) moon.style.display = 'block';
        localStorage.setItem('jm_portfolio_theme', 'dark');
      }
    }

    function toggleTheme() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      setTheme(isLight ? 'dark' : 'light');
      showToast(isLight ? 'Modo Oscuro activado' : 'Modo Claro activado');
    }

    function initTheme() {
      const saved = localStorage.getItem('jm_portfolio_theme');
      if (saved) {
        setTheme(saved);
      } else {
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(prefersDark ? 'dark' : 'dark');
      }
    }

    // Atmospheric rotating background graphic (smooth scroll-linked animation)
    let scrollTicking = false;
    function updateScrollRotation() {
      const orb = document.getElementById('spinning-bg-orb');
      if (!orb) return;
      const scrollY = window.pageYOffset || document.documentElement.scrollTop;
      orb.style.transform = `rotate(${scrollY * 0.14}deg)`;
    }

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        window.requestAnimationFrame(() => {
          updateScrollRotation();
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });

    // Keyboard shortcuts & initial setup
    function initApp() {
      initTheme();
      updateScrollRotation();
      const activeBtn = document.getElementById('btn-fullstack');
      updateGlider(activeBtn);
      switchAgent('tg');
      updateROI();
    }

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }

    window.addEventListener('resize', () => {
      const activeBtn = document.querySelector('.role-btn.active');
      updateGlider(activeBtn);
    });

    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT') return;
      if (e.key === '1') switchProfile('fullstack');
      if (e.key === '2') switchProfile('automation');
      if (e.key === '3') switchProfile('helpdesk');
      if (e.key === 'k' || e.key === 'K') toggleAIChat();
      if (e.key === 'Escape') {
        closeDetail();
        document.getElementById('ai-chat-scrim').classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  </script>
</body>
</html>
