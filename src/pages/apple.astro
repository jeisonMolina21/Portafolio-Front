      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
    .roi-stat-highlight {
      font-size: 2.25rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--accent-emerald);
      line-height: 1;
    }
    .roi-stat-sub {
      font-size: 0.8125rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    /* ── Project Showcase Cards ── */
    .project-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-xl);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      cursor: pointer;
      transition: transform 0.3s var(--spring-physics), border-color 0.3s ease, box-shadow 0.3s ease;
