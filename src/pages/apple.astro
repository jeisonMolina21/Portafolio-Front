    .step-badge-trigger { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
    .step-badge-agent { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
    .step-badge-db { background: rgba(52, 211, 153, 0.15); color: #34d399; }
    .step-badge-output { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }

    .step-title {
