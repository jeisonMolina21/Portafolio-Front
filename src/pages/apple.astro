<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Jeison Molina — Fullstack, RPA & Soporte TI</title>
  <meta name="description" content="Portafolio de Jeison Molina. Ingeniero de Sistemas y Desarrollador Fullstack, Especialista en Automatización RPA (Python, Pandas, n8n) y Soporte TI N1/N2." />

  <!-- Modern Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style is:global>
    /* ── Emil Kowalski & Fluid Motion Design System ── */
    :root {
      --bg-dark: #000000;
      --bg-surface: #09090b;
      --bg-card: rgba(18, 18, 22, 0.72);
      --bg-card-hover: rgba(26, 26, 32, 0.85);
      --bg-elevated: #16161a;

      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --text-dim: #71717a;

      --accent-blue: #38bdf8;
      --accent-emerald: #34d399;
      --accent-amber: #fbbf24;
      --accent-purple: #c084fc;

      --role-color: var(--accent-blue);
      --role-glow: rgba(56, 189, 248, 0.22);

      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-card: rgba(255, 255, 255, 0.1);
      --border-focus: rgba(255, 255, 255, 0.28);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-xl: 30px;
      --radius-pill: 9999px;

      --spring-physics: cubic-bezier(0.16, 1, 0.3, 1);
      --header-bg: rgba(0, 0, 0, 0.65);
    }

    /* ── Apple Light Mode Design System ── */
    html[data-theme="light"] {
      --bg-dark: #fbfbfd;
      --bg-surface: #f5f5f7;
      --bg-card: rgba(255, 255, 255, 0.92);
      --bg-card-hover: #ffffff;
      --bg-elevated: #ffffff;
      --header-bg: rgba(251, 251, 253, 0.82);

      --text-main: #1d1d1f;
      --text-muted: #6e6e73;
      --text-dim: #86868b;

      --accent-blue: #0071e3;
      --accent-emerald: #059669;
      --accent-amber: #d97706;
      --accent-purple: #7c3aed;

      --role-color: #0071e3;
      --role-glow: rgba(0, 113, 227, 0.15);

      --border-subtle: rgba(0, 0, 0, 0.07);
      --border-card: rgba(0, 0, 0, 0.11);
      --border-focus: rgba(0, 113, 227, 0.45);
    }

    /* ── Atmospheric Rotating Background Graphic (Scroll-Driven) ── */
    .spinning-bg-container {
      position: fixed;
      top: 6vh;
      right: -240px;
      width: 680px;
      height: 680px;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
      opacity: 0.28;
      transition: opacity 0.4s ease;
      mix-blend-mode: screen;
    }
    html[data-theme="light"] .spinning-bg-container {
      mix-blend-mode: multiply;
      opacity: 0.16;
    }
    .spinning-bg-orb {
      width: 100%;
      height: 100%;
      transform-origin: center center;
      will-change: transform;
    }

    /* ── Hero Profile Avatar ── */
    .hero-profile-row {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 1.5rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-card);
      padding: 6px 16px 6px 6px;
      border-radius: var(--radius-pill);
      backdrop-filter: blur(16px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      transition: all 0.3s var(--spring-physics);
    }
    .hero-profile-row:hover {
      border-color: var(--role-color);
      transform: translateY(-2px);
    }
    html[data-theme="light"] .hero-profile-row {
      background: rgba(0, 0, 0, 0.035);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }
    .hero-avatar-box {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      overflow: hidden;
      position: relative;
      border: 2px solid var(--role-color);
      flex-shrink: 0;
      box-shadow: 0 0 14px var(--role-glow);
    }
    .hero-avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── Contact Profile Avatar ── */
    .contact-avatar-wrapper {
      position: relative;
      width: 80px;
      height: 80px;
      margin: 0 auto 1.5rem auto;
      border-radius: 50%;
      border: 3px solid var(--role-color);
      box-shadow: 0 0 24px var(--role-glow);
    }
    .contact-avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }
    .contact-verified-badge {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 24px;
      height: 24px;
      background: var(--accent-emerald);
      color: #000;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
      border: 2px solid #000;
    }

    /* ── Theme Toggle Button ── */
    .theme-toggle-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-card);
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s var(--spring-physics);
      flex-shrink: 0;
    }
    .theme-toggle-btn:hover {
      background: rgba(255, 255, 255, 0.14);
      transform: scale(1.08) rotate(15deg);
      border-color: var(--role-color);
    }
    html[data-theme="light"] .theme-toggle-btn {
      background: rgba(0, 0, 0, 0.05);
      border-color: rgba(0, 0, 0, 0.12);
    }
    html[data-theme="light"] .theme-toggle-btn:hover {
      background: rgba(0, 0, 0, 0.09);
    }

    /* ── Light Mode Component Adjustments ── */
    html[data-theme="light"] body {
      background-color: var(--bg-dark);
      color: var(--text-main);
    }
    html[data-theme="light"] .top-header {
      background: var(--header-bg);
      border-color: var(--border-subtle);
    }
    html[data-theme="light"] .ambient-sphere {
      background: radial-gradient(circle, rgba(0, 113, 227, 0.08) 0%, rgba(200, 200, 220, 0) 70%);
    }
    html[data-theme="light"] .hero-title .hero-gradient-text {
      background: linear-gradient(180deg, #1d1d1f 0%, #434344 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    html[data-theme="light"] .bento-card,
    html[data-theme="light"] .project-card {
      background: var(--bg-card);
      border-color: var(--border-card);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    }
    html[data-theme="light"] .bento-card:hover,
    html[data-theme="light"] .project-card:hover {
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
      border-color: var(--border-focus);
    }
    html[data-theme="light"] .btn-glass {
      background: rgba(0, 0, 0, 0.04);
      color: #1d1d1f;
      border-color: rgba(0, 0, 0, 0.12);
    }
    html[data-theme="light"] .btn-solid {
      background: #1d1d1f;
      color: #ffffff;
    }
    html[data-theme="light"] .role-switcher {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.09);
    }
    html[data-theme="light"] .role-btn {
      color: #6e6e73;
    }
    html[data-theme="light"] .role-btn.active {
      color: #1d1d1f;
    }
    html[data-theme="light"] .role-glider {
      background: #ffffff;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    html[data-theme="light"] .agent-visualizer {
      background: #ffffff;
      border-color: var(--border-card);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06);
    }
    html[data-theme="light"] .agent-nav-bar {
      background: rgba(0, 0, 0, 0.02);
      border-color: var(--border-subtle);
    }
    html[data-theme="light"] .pipeline-canvas {
      background: radial-gradient(circle at 50% 20%, rgba(235, 238, 245, 0.9) 0%, rgba(255, 255, 255, 1) 75%);
    }
    html[data-theme="light"] .pipeline-step-card {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.09);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    }
    html[data-theme="light"] .step-title {
      color: #1d1d1f;
    }
    html[data-theme="light"] .agent-spec-panel {
      background: #fbfbfd;
    }
    html[data-theme="light"] .agent-info-col h3 {
      color: #1d1d1f;
    }
    html[data-theme="light"] .agent-stat-pill {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.08);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }
    html[data-theme="light"] .agent-stat-pill span:last-child {
      color: #1d1d1f;
    }
    html[data-theme="light"] .roi-calc-container {
      background: linear-gradient(180deg, #ffffff 0%, #f7f7f9 100%);
      border-color: var(--border-card);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06);
    }
    html[data-theme="light"] .roi-results-box {
      background: rgba(0, 0, 0, 0.03);
      border-color: rgba(0, 0, 0, 0.08);
    }
    html[data-theme="light"] .slider-label {
      color: #1d1d1f;
    }
    html[data-theme="light"] .apple-range {
      background: rgba(0, 0, 0, 0.1);
    }
    html[data-theme="light"] .tech-ribbon-item {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.08);
      color: #1d1d1f;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }
    html[data-theme="light"] .project-heading {
      color: #1d1d1f;
    }
    html[data-theme="light"] .bottom-thumb-bar {
      background: rgba(251, 251, 253, 0.88);
      border-color: rgba(0, 0, 0, 0.08);
    }
    html[data-theme="light"] .ai-bubble {
      background: rgba(255, 255, 255, 0.9);
      color: #1d1d1f;
      border-color: rgba(0, 0, 0, 0.12);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }
    html[data-theme="light"] .sheet-panel {
      background: #ffffff;
      color: #1d1d1f;
      border-color: rgba(0, 0, 0, 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
      padding-bottom: 84px;
    }

    @media (min-width: 1024px) {
      body {
        padding-bottom: 0;
      }
    }

    /* ── Instant Pointer Feedback (Kill Latency rule) ── */
    button, a, .clickable {
      cursor: pointer;
      touch-action: manipulation;
      user-select: none;
    }
    button:active, a.btn:active, .card-interactive:active {
      transform: scale(0.975);
      transition: transform 90ms ease-out;
    }

    /* ── Floating Header ── */
    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(24px) saturate(190%);
      -webkit-backdrop-filter: blur(24px) saturate(190%);
      border-bottom: 1px solid var(--border-subtle);
      z-index: 999;
      display: flex;
      align-items: center;
      transition: background 0.3s ease;
    }

    .header-inner {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #fff;
      text-decoration: none;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: -0.03em;
    }

    .brand-badge {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.03));
      border: 1px solid var(--border-card);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 900;
      color: var(--role-color);
      transition: color 0.3s ease;
    }

    .nav-menu {
      display: none;
      list-style: none;
      align-items: center;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      .nav-menu {
        display: flex;
      }
    }

    .nav-menu a {
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      transition: color 0.15s ease;
    }
    .nav-menu a:hover {
      color: #fff;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    /* ── Snappy Modern Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.45rem 1.05rem;
      border-radius: var(--radius-pill);
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid transparent;
      transition: all 0.2s var(--spring-physics);
    }

    .btn-solid {
      background: #ffffff;
      color: #000000;
    }
    .btn-solid:hover {
      background: #e4e4e7;
      box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
    }

    .btn-glass {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-main);
      border-color: var(--border-card);
    }
    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--border-focus);
    }

    /* ── Hero Section (Fluid Dynamics) ── */
    .hero-section {
      padding: 110px 1.5rem 70px 1.5rem;
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    @media (min-width: 1024px) {
      .hero-section {
        padding: 140px 1.5rem 90px 1.5rem;
      }
    }

    /* Dynamic Ambient Glow */
    .ambient-sphere {
      position: absolute;
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 780px;
      height: 480px;
      background: radial-gradient(ellipse at center, var(--role-glow) 0%, transparent 70%);
      filter: blur(100px);
      pointer-events: none;
      z-index: 0;
      transition: background 0.6s ease;
    }

    .hero-content {
      position: relative;
      z-index: 10;
      max-width: 860px;
      margin: 0 auto;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      background: rgba(52, 211, 153, 0.08);
      border: 1px solid rgba(52, 211, 153, 0.22);
      color: var(--accent-emerald);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 1.5rem;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 10px var(--accent-emerald);
      animation: pulse-ring 2s infinite ease-in-out;
    }

    @keyframes pulse-ring {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }

    .hero-title {
      font-size: clamp(2.75rem, 7vw, 5.25rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.04;
      margin-bottom: 1.25rem;
    }

    .hero-gradient-text {
      background: linear-gradient(180deg, #ffffff 40%, rgba(255, 255, 255, 0.6) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-role-text {
      color: var(--role-color);
      transition: color 0.35s ease;
    }

    .hero-desc {
      font-size: clamp(1rem, 2vw, 1.25rem);
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 680px;
      margin: 0 auto 2.25rem auto;
      font-weight: 400;
    }

    /* ── Sliding Spring Segmented Control ── */
    .role-switcher-container {
      display: flex;
      justify-content: center;
      margin-bottom: 2.75rem;
      position: relative;
    }

    .role-switcher {
      position: relative;
      display: inline-flex;
      background: rgba(22, 22, 28, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-pill);
      padding: 5px;
      gap: 4px;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .role-switcher::-webkit-scrollbar {
      display: none;
    }

    .role-btn {
      position: relative;
      z-index: 2;
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 0.8125rem;
      font-weight: 600;
      padding: 0.5rem 1.25rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s ease;
      white-space: nowrap;
    }

    .role-btn.active {
      color: #ffffff;
    }

    /* Active Gliding Pill */
    .role-glider {
      position: absolute;
      top: 5px;
      left: 5px;
      height: calc(100% - 10px);
      background: var(--role-color);
      border-radius: var(--radius-pill);
      transition: all 0.3s var(--spring-physics);
      z-index: 1;
      box-shadow: 0 4px 18px var(--role-glow);
    }

    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* ── Bento Grid (Interactive Spotlight Border) ── */
    .section-shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.5rem 80px 1.5rem;
    }

    .section-head {
      margin-bottom: 2rem;
    }
    .section-tag {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--role-color);
      margin-bottom: 0.4rem;
      transition: color 0.3s ease;
    }
    .section-title {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    .bento-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    @media (min-width: 768px) {
      .bento-grid {
        grid-template-columns: repeat(12, 1fr);
      }
    }

    .bento-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-xl);
      padding: 2rem;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s var(--spring-physics), border-color 0.25s ease;
    }

    .bento-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-focus);
    }

    /* Spotlight effect border */
    .bento-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: radial-gradient(450px circle at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(255, 255, 255, 0.22), transparent 40%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      z-index: 10;
    }

    .col-12 { grid-column: span 12; }
    .col-8 { grid-column: span 12; }
    .col-6 { grid-column: span 12; }
    .col-4 { grid-column: span 12; }

    @media (min-width: 768px) {
      .col-8 { grid-column: span 8; }
      .col-6 { grid-column: span 6; }
      .col-4 { grid-column: span 4; }
    }

    /* Metric Display */
    .metric-num {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: 0.35rem;
    }

    .metric-caption {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    /* ── n8n AI Agents & Workflow Visualizer ── */
    .agent-visualizer {
      background: #0b0b0f;
      border: 1px solid var(--border-card);
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      transition: border-color 0.3s ease;
    }
    .agent-visualizer:hover {
      border-color: rgba(255, 255, 255, 0.18);
    }

    .agent-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 18px;
      background: rgba(255, 255, 255, 0.025);
      border-bottom: 1px solid var(--border-subtle);
      flex-wrap: wrap;
      gap: 10px;
    }

    .agent-tabs-group {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
