    .project-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-focus);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.7);
    }

    .project-thumb {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: #111;
    }

    .project-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--spring-physics);
    }

    .project-card:hover .project-thumb img {
      transform: scale(1.04);
    }

    .project-badge-pill {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .project-details {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .project-heading {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }

    .project-summary {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.55;
      margin-bottom: 1.25rem;
      flex: 1;
    }

    .tech-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 1.25rem;
    }

    .tech-pill {
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
    }

    .project-cta {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--role-color);
      font-size: 0.8125rem;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    /* ── Native Fluid Sheet / Drawer (Interruptible Motion) ── */
    .sheet-scrim {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s ease;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    @media (min-width: 768px) {
      .sheet-scrim {
        align-items: center;
        padding: 2rem;
      }
    }

    .sheet-scrim.active {
      opacity: 1;
      pointer-events: auto;
    }

    .sheet-panel {
      background: #121216;
      border: 1px solid var(--border-card);
      border-radius: 26px 26px 0 0;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 2rem;
      transform: translateY(100%);
      transition: transform 0.35s var(--spring-physics);
    }

    @media (min-width: 768px) {
      .sheet-panel {
        border-radius: 26px;
        max-width: 720px;
        transform: scale(0.96) translateY(20px);
      }
    }

    .sheet-scrim.active .sheet-panel {
      transform: translateY(0) scale(1);
    }

    .sheet-drag-handle {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.2);
      margin: -0.5rem auto 1.25rem auto;
      display: block;
    }

    @media (min-width: 768px) {
      .sheet-drag-handle {
        display: none;
      }
    }

    /* ── Floating AI Quick Assistant ── */
    .ai-bubble {
      position: fixed;
      bottom: 95px;
      right: 1.5rem;
      z-index: 800;
      padding: 0.65rem 1.15rem;
      border-radius: var(--radius-pill);
      background: rgba(18, 18, 24, 0.88);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #ffffff;
      font-size: 0.8125rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 20px rgba(168, 85, 247, 0.25);
      transition: all 0.25s var(--spring-physics);
    }

    @media (min-width: 1024px) {
      .ai-bubble {
        bottom: 2rem;
        right: 2rem;
      }
    }

    .ai-bubble:hover {
      transform: scale(1.04);
      border-color: rgba(168, 85, 247, 0.6);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8), 0 0 28px rgba(168, 85, 247, 0.5);
    }

    .ai-sparkle {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: linear-gradient(135deg, #38bdf8, #c084fc, #f43f5e);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 10px;
    }

    /* ── Mobile Bottom Thumb Bar ── */
    .bottom-thumb-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: rgba(10, 10, 14, 0.88);
      backdrop-filter: blur(24px) saturate(200%);
      -webkit-backdrop-filter: blur(24px) saturate(200%);
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-around;
      z-index: 850;
      padding-bottom: env(safe-area-inset-bottom);
    }

    @media (min-width: 1024px) {
      .bottom-thumb-bar {
        display: none;
      }
    }

    .thumb-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.625rem;
      font-weight: 600;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 6px 14px;
    }

    .thumb-btn.active, .thumb-btn:hover {
      color: var(--role-color);
    }

    /* ── Sonner Toast Notification ── */
    .toast {
      position: fixed;
      bottom: 85px;
      left: 50%;
      transform: translateX(-50%) translateY(80px);
      opacity: 0;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-pill);
      background: rgba(28, 28, 32, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-card);
      color: #fff;
      font-size: 0.8125rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
      z-index: 1200;
      transition: all 0.28s var(--spring-physics);
      pointer-events: none;
    }
    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body>

  <!-- Atmospheric Rotating Background Graphic (Scroll-Driven) -->
