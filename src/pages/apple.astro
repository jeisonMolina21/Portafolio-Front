        grid-template-columns: 1.1fr 1fr;
      }
    }

    .agent-info-col h3 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: #fff;
    }
    .agent-info-col p {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }

    .agent-stats-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }
    .agent-stat-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      display: flex;
      flex-direction: column;
    }
    .agent-stat-pill span:first-child {
      font-size: 0.625rem;
